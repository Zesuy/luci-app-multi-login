{
    "luci-app-multi-login": {
        "description": "Grant access to multilogin configuration",
        "read": {
            "uci": [
                "multilogin",
                "network",
                "firewall",
                "mwan3"
            ],
            "file": [
                "/var/log/multilogin.log"
            ],
            "ubus": {
                "luci": [
                    "getInitList"
                ],
                "service": [
                    "list"
                ],
                "multilogin": [
                    "list_auto",
                    "check_instance",
                    "test_instance",
                    "logout_instance",
                    "script_info",
                    "script_check",
                    "script_get_draft"
                ]
            }
        },
        "write": {
            "uci": [
                "multilogin",
                "network",
                "firewall",
                "mwan3"
            ],
            "ubus": {
                "luci": [
                    "setInitAction"
                ],
                "multilogin": [
                    "quick_setup",
                    "remove_auto",
                    "save_instance",
                    "delete_instance",
                    "logout_instance",
                    "save_account",
                    "delete_account",
                    "script_stage",
                    "script_validate",
                    "script_activate",
                    "script_rollback",
                    "script_restore",
                    "script_save_draft",
                    "script_discard_draft"
                ]
            }
        }
    }
}
