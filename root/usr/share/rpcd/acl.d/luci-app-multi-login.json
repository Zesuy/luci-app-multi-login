{
  "luci-app-multi-login": {
    "description": "Grant access only to fixed non-secret MultiLogin RPC methods",
    "read": {
      "ubus": {
        "multilogin": [
          "get_overview", "get_settings", "list_accounts", "list_instances",
          "service_status", "get_diagnostics", "get_logs", "list_auto",
          "check_instance", "script_info", "script_check", "script_get_draft"
        ]
      }
    },
    "write": {
      "ubus": {
        "multilogin": [
          "save_settings", "save_account", "delete_account", "save_instance",
          "delete_instance", "service_action", "clear_logs", "quick_setup",
          "remove_auto", "network_recover", "test_instance", "logout_instance",
          "script_stage", "script_validate", "script_activate", "script_rollback",
          "script_restore", "script_save_draft", "script_discard_draft"
        ]
      }
    }
  }
}
