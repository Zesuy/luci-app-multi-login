#!/bin/sh

# rpcd handler for multilogin plugin
# Exposed as ubus object "multilogin" with methods:
#   quick_setup    - Generate macvlan + network + firewall + mwan3 config
#   list_auto      - List all auto_* managed sections
#   remove_auto    - Remove all auto_* managed sections

# Usage by rpcd: this script is called with 'list' or 'call <method>'

. /usr/share/libubox/jshn.sh

instance_status_text() {
    local action="$1"
    local code="$2"

    if [ "$action" = "check" ]; then
        case "$code" in
            0) echo "已登录" ;;
            1) echo "未登录" ;;
            *) echo "状态检查失败" ;;
        esac
    elif [ "$action" = "logout" ]; then
        case "$code" in
            0) echo "注销成功" ;;
            1) echo "注销失败" ;;
            *) echo "脚本错误" ;;
        esac
    else
        case "$code" in
            0) echo "登录成功" ;;
            1) echo "登录失败" ;;
            2) echo "已登录" ;;
            *) echo "脚本错误" ;;
        esac
    fi
}

emit_instance_result() {
    local action="$1"
    local section="$2"
    local alias_name="$3"
    local interface="$4"
    local v6face="$5"
    local account_ref="$6"
    local username="$7"
    local ua_type="$8"
    local code="$9"
    local output="${10}"

    local status_text
    status_text=$(instance_status_text "$action" "$code")

    json_init
    json_add_string action "$action"
    json_add_string section "$section"
    json_add_string alias "$alias_name"
    json_add_string interface "$interface"
    json_add_string v6face "$v6face"
    json_add_string account_ref "$account_ref"
    json_add_string username "$username"
    json_add_string ua_type "$ua_type"
    json_add_int code "$code"
    json_add_string status "$status_text"
    json_add_boolean success $([ "$code" -eq 0 ] && echo 1 || echo 0)
    json_add_string output "$output"
    json_dump
    printf '\n'
}

load_instance_config() {
    local section="$1"

    INSTANCE_ALIAS=$(uci -q get "multilogin.$section.alias")
    INSTANCE_INTERFACE=$(uci -q get "multilogin.$section.interface")
    INSTANCE_V6FACE=$(uci -q get "multilogin.$section.v6face")
    INSTANCE_UA_TYPE=$(uci -q get "multilogin.$section.ua_type")
    [ -n "$INSTANCE_UA_TYPE" ] || INSTANCE_UA_TYPE="pc"
    INSTANCE_ACCOUNT_REF=$(uci -q get "multilogin.$section.account")
    INSTANCE_USERNAME=""
    INSTANCE_PASSWORD=""

    if [ -n "$INSTANCE_ACCOUNT_REF" ]; then
        INSTANCE_USERNAME=$(uci -q get "multilogin.$INSTANCE_ACCOUNT_REF.username")
        INSTANCE_PASSWORD=$(uci -q get "multilogin.$INSTANCE_ACCOUNT_REF.password")
    fi
}

validate_instance_for_action() {
    local section="$1"

    if [ -z "$section" ]; then
        printf '{"error":"missing section"}\n'
        return 1
    fi

    if [ "$(uci -q get "multilogin.$section")" != "instance" ]; then
        printf '{"error":"instance not found"}\n'
        return 1
    fi

    load_instance_config "$section"

    if [ -z "$INSTANCE_INTERFACE" ] || [ -z "$INSTANCE_USERNAME" ] || [ -z "$INSTANCE_PASSWORD" ]; then
        printf '{"error":"instance config incomplete"}\n'
        return 1
    fi

    return 0
}

case "$1" in
    list)
        printf '{"quick_setup":{"base_iface":"","count":0},"list_auto":{},"remove_auto":{},"check_instance":{"section":""},"test_instance":{"section":""},"logout_instance":{"section":""},"save_instance":{"section":"","enabled":"","alias":"","interface":"","v6face":"","account":"","ua_type":""},"delete_instance":{"section":""},"save_account":{"section":"","alias":"","username":"","password":""},"delete_account":{"section":""}}\n'
        ;;
    call)
        case "$2" in
            quick_setup)
                # Read JSON params from stdin: {"base_iface":"eth0","count":3}
                json=$(cat)
                BASE_IF=$(echo "$json" | jsonfilter -e '@.base_iface' 2>/dev/null)
                COUNT=$(echo "$json" | jsonfilter -e '@.count' 2>/dev/null)

                if [ -z "$BASE_IF" ] || [ -z "$COUNT" ] || [ "$COUNT" -lt 1 ] 2>/dev/null; then
                    printf '{"error":"invalid parameters: base_iface and count are required"}\n'
                    exit 1
                fi

                # --- Cleanup old auto_ entries ---
                # Remove auto_ network interfaces and devices
                for section in $(uci show network | grep -oE '^network\.[^.]+' | sort -u); do
                    name="${section#network.}"
                    case "$name" in auto_*) uci -q delete "network.$name" ;; esac
                done

                # Remove auto_ sections from mwan3
                for section in $(uci show mwan3 | grep -oE '^mwan3\.[^.]+' | sort -u); do
                    name="${section#mwan3.}"
                    case "$name" in auto_*) uci -q delete "mwan3.$name" ;; esac
                done

                # Find wan zone and remove old auto_ entries from it
                WAN_ZONE=""
                for z in $(uci show firewall | grep "=zone" | grep -oE "firewall\.[^=]+=zone" | awk -F= '{print $1}' | awk -F. '{print $2}'); do
                    if [ "$(uci -q get "firewall.$z.name")" = "wan" ]; then
                        WAN_ZONE="$z"
                        break
                    fi
                done

                if [ -n "$WAN_ZONE" ]; then
                    idx=0
                    while true; do
                        val=$(uci -q get "firewall.$WAN_ZONE.network" 2>/dev/null | awk -v i=$((idx+1)) 'NR==i')
                        [ -z "$val" ] && break
                        case "$val" in
                            auto_*) uci -q del_list "firewall.$WAN_ZONE.network=$val" ;;
                        esac
                        idx=$((idx+1))
                    done
                    # More robust cleanup using the list form
                    for net in $(uci -q get "firewall.$WAN_ZONE.network"); do
                        case "$net" in auto_*) uci del_list "firewall.$WAN_ZONE.network=$net" ;; esac
                    done
                fi

                # Cleanup auto_ members from balanced policy
                for mem in $(uci -q get mwan3.balanced.use_member 2>/dev/null); do
                    case "$mem" in auto_*) uci del_list "mwan3.balanced.use_member=$mem" ;; esac
                done

                # --- Create new configs ---
                i=1
                while [ "$i" -le "$COUNT" ]; do
                    MACVLAN_DEV="auto_${BASE_IF}_${i}"
                    LOGICAL_IF="auto_vwan_${i}"
                    MWAN_MEMBER="auto_vwan_${i}_m1_w5"
                    METRIC=$((10 + i))

                    # Network: macvlan device
                    uci set "network.$MACVLAN_DEV=device"
                    uci set "network.$MACVLAN_DEV.type=macvlan"
                    uci set "network.$MACVLAN_DEV.ifname=$BASE_IF"
                    uci set "network.$MACVLAN_DEV.name=$MACVLAN_DEV"
                    uci set "network.$MACVLAN_DEV.mode=private"
                    uci set "network.$MACVLAN_DEV.ipv6=0"

                    # Network: logical DHCP interface
                    uci set "network.$LOGICAL_IF=interface"
                    uci set "network.$LOGICAL_IF.proto=dhcp"
                    uci set "network.$LOGICAL_IF.device=$MACVLAN_DEV"
                    uci set "network.$LOGICAL_IF.metric=$METRIC"

                    # Firewall: add to wan zone
                    if [ -n "$WAN_ZONE" ]; then
                        uci add_list "firewall.$WAN_ZONE.network=$LOGICAL_IF"
                    fi

                    # mwan3: tracking interface
                    uci set "mwan3.$LOGICAL_IF=interface"
                    uci set "mwan3.$LOGICAL_IF.enabled=1"
                    uci set "mwan3.$LOGICAL_IF.family=ipv4"
                    uci set "mwan3.$LOGICAL_IF.initial_state=offline"
                    uci set "mwan3.$LOGICAL_IF.track_method=ping"
                    uci set "mwan3.$LOGICAL_IF.reliability=1"
                    uci set "mwan3.$LOGICAL_IF.count=1"
                    uci set "mwan3.$LOGICAL_IF.size=56"
                    uci set "mwan3.$LOGICAL_IF.max_ttl=60"
                    uci set "mwan3.$LOGICAL_IF.timeout=2"
                    uci set "mwan3.$LOGICAL_IF.interval=5"
                    uci set "mwan3.$LOGICAL_IF.failure_interval=5"
                    uci set "mwan3.$LOGICAL_IF.recovery_interval=5"
                    uci set "mwan3.$LOGICAL_IF.down=2"
                    uci set "mwan3.$LOGICAL_IF.up=3"
                    uci add_list "mwan3.$LOGICAL_IF.track_ip=223.5.5.5"
                    uci add_list "mwan3.$LOGICAL_IF.track_ip=114.114.114.114"

                    # mwan3: member
                    uci set "mwan3.$MWAN_MEMBER=member"
                    uci set "mwan3.$MWAN_MEMBER.interface=$LOGICAL_IF"
                    uci set "mwan3.$MWAN_MEMBER.metric=1"
                    uci set "mwan3.$MWAN_MEMBER.weight=5"

                    # mwan3: add member to balanced policy
                    uci -q get mwan3.balanced >/dev/null 2>&1 || { uci set mwan3.balanced=policy; uci set mwan3.balanced.last_resort=unreachable; }
                    uci add_list "mwan3.balanced.use_member=$MWAN_MEMBER"

                    i=$((i+1))
                done

                # Commit all changes
                uci commit network
                uci commit firewall
                uci commit mwan3

                # Apply
                /etc/init.d/network reload >/dev/null 2>&1 &
                /etc/init.d/firewall reload >/dev/null 2>&1 &
                /etc/init.d/mwan3 reload >/dev/null 2>&1 &

                printf '{"result":"ok","count":%s,"base_iface":"%s"}\n' "$COUNT" "$BASE_IF"
                ;;

            list_auto)
                # Return list of all auto_ managed sections
                # Correct pattern: filter whole lines first, then extract section name
                IFACES=$(uci show network | grep -E "^network\.auto_[^.=]+=interface$" | sed "s/network\.\([^.=]*\)=interface/\1/" | sort -u)
                DEVICES=$(uci show network | grep -E "^network\.auto_[^.=]+=device$" | sed "s/network\.\([^.=]*\)=device/\1/" | sort -u)

                # Get base_iface from first device if exists
                FIRST_DEV=$(echo "$DEVICES" | head -n1)
                BASE_IF=""
                COUNT=0
                if [ -n "$FIRST_DEV" ]; then
                    BASE_IF=$(uci -q get "network.$FIRST_DEV.ifname" 2>/dev/null)
                    COUNT=$(echo "$IFACES" | grep -c .)
                fi

                printf '{"base_iface":"%s","count":%s,"interfaces":[' "$BASE_IF" "$COUNT"
                first=1
                for iface in $IFACES; do
                    dev=$(uci -q get "network.$iface.device" 2>/dev/null)
                    metric=$(uci -q get "network.$iface.metric" 2>/dev/null)
                    [ "$first" = "1" ] && first=0 || printf ','
                    printf '{"name":"%s","device":"%s","metric":"%s"}' "$iface" "$dev" "$metric"
                done
                printf ']}\n'
                ;;

            remove_auto)
                # Remove all auto_ configs
                for section in $(uci show network | grep -oE 'network\.auto_[^.]+' | awk -F. '{print $2}' | sort -u); do
                    uci -q delete "network.$section"
                done
                for section in $(uci show mwan3 2>/dev/null | grep -oE 'mwan3\.auto_[^.]+' | awk -F. '{print $2}' | sort -u); do
                    uci -q delete "mwan3.$section"
                done
                # Clean WAN zone
                for z in $(uci show firewall | grep "=zone" | grep -oE "firewall\.[^.=]+" | awk -F. '{print $2}'); do
                    if [ "$(uci -q get "firewall.$z.name")" = "wan" ]; then
                        for net in $(uci -q get "firewall.$z.network"); do
                            case "$net" in auto_*) uci del_list "firewall.$z.network=$net" ;; esac
                        done
                        break
                    fi
                done
                # Clean balanced members
                for mem in $(uci -q get mwan3.balanced.use_member 2>/dev/null); do
                    case "$mem" in auto_*) uci del_list "mwan3.balanced.use_member=$mem" ;; esac
                done

                uci commit network
                uci commit firewall
                uci commit mwan3

                /etc/init.d/network reload >/dev/null 2>&1 &
                /etc/init.d/firewall reload >/dev/null 2>&1 &
                /etc/init.d/mwan3 reload >/dev/null 2>&1 &

                printf '{"result":"ok"}\n'
                ;;

            check_instance)
                json=$(cat)
                SECTION=$(echo "$json" | jsonfilter -e '@.section' 2>/dev/null)

                validate_instance_for_action "$SECTION" || exit 1

                TMP_OUT=$(mktemp /tmp/multilogin-check.XXXXXX)
                /etc/multilogin/check_status.sh \
                    --mwan3 "$INSTANCE_INTERFACE" \
                    --account "$INSTANCE_USERNAME" \
                    --password "$INSTANCE_PASSWORD" \
                    --ua-type "$INSTANCE_UA_TYPE" \
                    --v6face "$INSTANCE_V6FACE" >"$TMP_OUT" 2>&1
                CODE=$?
                OUTPUT=$(cat "$TMP_OUT" 2>/dev/null)
                rm -f "$TMP_OUT"

                emit_instance_result "check" "$SECTION" "$INSTANCE_ALIAS" "$INSTANCE_INTERFACE" "$INSTANCE_V6FACE" "$INSTANCE_ACCOUNT_REF" "$INSTANCE_USERNAME" "$INSTANCE_UA_TYPE" "$CODE" "$OUTPUT"
                ;;

            test_instance)
                json=$(cat)
                SECTION=$(echo "$json" | jsonfilter -e '@.section' 2>/dev/null)

                validate_instance_for_action "$SECTION" || exit 1

                TMP_OUT=$(mktemp /tmp/multilogin-test.XXXXXX)
                sh /etc/multilogin/login.sh \
                    --mwan3 "$INSTANCE_INTERFACE" \
                    --account "$INSTANCE_USERNAME" \
                    --password "$INSTANCE_PASSWORD" \
                    --ua-type "$INSTANCE_UA_TYPE" \
                    --v6face "$INSTANCE_V6FACE" >"$TMP_OUT" 2>&1
                CODE=$?
                OUTPUT=$(cat "$TMP_OUT" 2>/dev/null)
                rm -f "$TMP_OUT"

                emit_instance_result "test" "$SECTION" "$INSTANCE_ALIAS" "$INSTANCE_INTERFACE" "$INSTANCE_V6FACE" "$INSTANCE_ACCOUNT_REF" "$INSTANCE_USERNAME" "$INSTANCE_UA_TYPE" "$CODE" "$OUTPUT"
                ;;

            logout_instance)
                json=$(cat)
                SECTION=$(echo "$json" | jsonfilter -e '@.section' 2>/dev/null)

                validate_instance_for_action "$SECTION" || exit 1

                TMP_OUT=$(mktemp /tmp/multilogin-logout.XXXXXX)
                sh /etc/multilogin/logout.sh \
                    --mwan3 "$INSTANCE_INTERFACE" \
                    --account "$INSTANCE_USERNAME" \
                    --password "$INSTANCE_PASSWORD" \
                    --ua-type "$INSTANCE_UA_TYPE" \
                    --v6face "$INSTANCE_V6FACE" >"$TMP_OUT" 2>&1
                CODE=$?
                OUTPUT=$(cat "$TMP_OUT" 2>/dev/null)
                rm -f "$TMP_OUT"

                emit_instance_result "logout" "$SECTION" "$INSTANCE_ALIAS" "$INSTANCE_INTERFACE" "$INSTANCE_V6FACE" "$INSTANCE_ACCOUNT_REF" "$INSTANCE_USERNAME" "$INSTANCE_UA_TYPE" "$CODE" "$OUTPUT"
                ;;

            save_instance)
                json=$(cat)
                SECTION=$(echo "$json" | jsonfilter -e '@.section' 2>/dev/null)
                ENABLED=$(echo "$json" | jsonfilter -e '@.enabled' 2>/dev/null)
                ALIAS_NAME=$(echo "$json" | jsonfilter -e '@.alias' 2>/dev/null)
                INTERFACE=$(echo "$json" | jsonfilter -e '@.interface' 2>/dev/null)
                V6FACE=$(echo "$json" | jsonfilter -e '@.v6face' 2>/dev/null)
                ACCOUNT=$(echo "$json" | jsonfilter -e '@.account' 2>/dev/null)
                UA_TYPE=$(echo "$json" | jsonfilter -e '@.ua_type' 2>/dev/null)

                [ -n "$ENABLED" ] || ENABLED="0"
                [ -n "$UA_TYPE" ] || UA_TYPE="pc"

                if [ -z "$INTERFACE" ] || [ -z "$ACCOUNT" ]; then
                    printf '{"error":"interface and account are required"}\n'
                    exit 1
                fi

                if [ -n "$SECTION" ] && [ "$(uci -q get "multilogin.$SECTION")" != "instance" ]; then
                    printf '{"error":"instance not found"}\n'
                    exit 1
                fi

                if [ -z "$SECTION" ]; then
                    SECTION=$(uci add multilogin instance)
                fi

                uci set "multilogin.$SECTION=instance"
                uci set "multilogin.$SECTION.enabled=$ENABLED"
                uci set "multilogin.$SECTION.alias=$ALIAS_NAME"
                uci set "multilogin.$SECTION.interface=$INTERFACE"
                uci set "multilogin.$SECTION.account=$ACCOUNT"
                uci set "multilogin.$SECTION.ua_type=$UA_TYPE"
                if [ -n "$V6FACE" ]; then
                    uci set "multilogin.$SECTION.v6face=$V6FACE"
                else
                    uci -q delete "multilogin.$SECTION.v6face"
                fi

                uci commit multilogin
                /etc/init.d/multilogin restart >/dev/null 2>&1 &

                printf '{"result":"ok","section":"%s"}\n' "$SECTION"
                ;;

            save_account)
                json=$(cat)
                SECTION=$(echo "$json" | jsonfilter -e '@.section' 2>/dev/null)
                ALIAS_NAME=$(echo "$json" | jsonfilter -e '@.alias' 2>/dev/null)
                USERNAME=$(echo "$json" | jsonfilter -e '@.username' 2>/dev/null)
                PASSWORD=$(echo "$json" | jsonfilter -e '@.password' 2>/dev/null)

                if [ -z "$USERNAME" ]; then
                    printf '{"error":"username is required"}\n'
                    exit 1
                fi

                if [ -n "$SECTION" ] && [ "$(uci -q get "multilogin.$SECTION")" != "account" ]; then
                    printf '{"error":"account not found"}\n'
                    exit 1
                fi

                if [ -z "$SECTION" ]; then
                    SECTION=$(uci add multilogin account)
                fi

                if [ -z "$PASSWORD" ] && [ "$(uci -q get "multilogin.$SECTION.password")" = "" ]; then
                    printf '{"error":"password is required"}\n'
                    exit 1
                fi

                uci set "multilogin.$SECTION.alias=$ALIAS_NAME"
                uci set "multilogin.$SECTION.username=$USERNAME"
                if [ -n "$PASSWORD" ]; then
                    uci set "multilogin.$SECTION.password=$PASSWORD"
                fi
                uci commit multilogin

                printf '{"result":"ok","section":"%s"}\n' "$SECTION"
                ;;

            delete_account)
                json=$(cat)
                SECTION=$(echo "$json" | jsonfilter -e '@.section' 2>/dev/null)

                if [ -z "$SECTION" ]; then
                    printf '{"error":"missing section"}\n'
                    exit 1
                fi

                if [ "$(uci -q get "multilogin.$SECTION")" != "account" ]; then
                    printf '{"error":"account not found"}\n'
                    exit 1
                fi

                uci delete "multilogin.$SECTION"
                uci commit multilogin

                printf '{"result":"ok"}\n'
                ;;

            delete_instance)
                json=$(cat)
                SECTION=$(echo "$json" | jsonfilter -e '@.section' 2>/dev/null)

                if [ -z "$SECTION" ]; then
                    printf '{"error":"missing section"}\n'
                    exit 1
                fi

                if [ "$(uci -q get "multilogin.$SECTION")" != "instance" ]; then
                    printf '{"error":"instance not found"}\n'
                    exit 1
                fi

                uci -q delete "multilogin.$SECTION"
                uci commit multilogin
                /etc/init.d/multilogin restart >/dev/null 2>&1 &

                printf '{"result":"ok"}\n'
                ;;

            *)
                printf '{"error":"unknown method"}\n'
                exit 1
                ;;
        esac
        ;;
    *)
        printf '{"error":"unsupported action"}\n'
        exit 1
        ;;
esac
